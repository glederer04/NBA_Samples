{
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv-devcontainer/bin/python",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/nba_comp_dashboard",
        "${workspaceFolder}/nba_rotation_lab/src"
    ],
    "files.exclude": {
        "**/.venv": true,
        "**/.venv-devcontainer": true,
        "**/.venv-macos-py39": true,
        "**/__pycache__": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/.venv-devcontainer": true,
        "**/.venv-macos-py39": true,
        "**/__pycache__": true
    }
}
